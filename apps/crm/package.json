{
  "name": "buzzkill-crm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node ../web/scripts/checkMigrationRelease.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "outputs": "AWS_REGION=us-east-1 NODE_OPTIONS=--no-experimental-webstorage ampx generate outputs --app-id ${BUZZKILL_BACKEND_APP_ID:-d26qpsjewk0bee} --branch ${AWS_BRANCH:-staging}",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-amplify/ui-react": "^6.15.4",
    "@stripe/react-stripe-js": "^6.7.0",
    "@stripe/stripe-js": "^9.10.0",
    "aws-amplify": "~6.15.10",
    "react": "~18.3.1",
    "react-dom": "~18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@aws-amplify/backend-cli": "~1.8.1",
    "@types/react": "~18.3.27",
    "@types/react-dom": "~18.3.7",
    "@vitejs/plugin-react": "~5.1.2",
    "jsdom": "26.1.0",
    "typescript": "~5.9.3",
    "vite": "~7.3.1",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">= 20.20.0",
    "npm": ">= 10.8.0"
  },
  "overrides": {
    "fast-xml-parser@<5": "4.5.7",
    "fast-xml-parser@>=5 <5.7.2": "5.7.2",
    "js-cookie": "3.0.8",
    "lodash": "4.18.1"
  }
}
